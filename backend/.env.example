# Backend environment variables
# Copy this file to .env and replace the placeholders.

# Supabase server configuration (required by the backend)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# JWT configuration (use a long, unique secret in production)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS - Your frontend Vercel URL (no trailing slash)
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Initial production administrator (used only when the Supabase users table is empty)
# ADMIN_NAME=Admin User
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-8-characters

# Optional values for a one-time MongoDB import only.
# Keep the source URI in a trusted, untracked environment; it is not needed by the running app.
# MONGODB_URI=mongodb+srv://<user>:<password>@<host>/<database>

NODE_ENV=development
PORT=5000
